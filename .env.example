# Keys this app reads. NAMES only, never values - the real values belong in
# the workspace's App .env field, not in git.
#
# Do NOT declare PORT or DATABASE_URL here: the fleet injects those
# at launch and a copy in the App .env would collide with them.

# Optional: the image to process (default data/fruits.jpg) and where the
# results go (default out/).
INPUT_IMAGE=
OUTPUT_DIR=
